# Same Supabase project as the existing family dashboard (free plan).
# King Family Dash only touches kf_* tables. Paste the project URL and anon key.
# These two are public in the browser bundle.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server only. Used by api/admin-users.js so an admin can set or reset a password.
# Set this in .env for local dev and as a Vercel secret. Never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
